# Copy to .env.local and fill in. Validated at startup by lib/env/client.ts
# (public) and lib/env/server.ts (server-only); the app refuses to run without
# the required values. .env* is gitignored -- never commit real keys.

# --- Public (inlined into the browser bundle; never put secrets here) ---
NEXT_PUBLIC_SUPABASE_URL=            # Supabase project URL, e.g. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # sb_publishable_... (Project Settings -> API Keys)

# --- Server-only (secrets) ---
SUPABASE_SECRET_KEY=                 # sb_secret_... -- bypasses RLS; server actions + seed script only
RESEND_API_KEY=                      # re_... (resend.com -> API Keys)
RESEND_FROM=                         # optional; defaults to "SWAMP MAGAZINE <onboarding@resend.dev>" until the domain is verified (P5)
